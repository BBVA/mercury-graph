{
// NOTE on EDITING:
// ----------------
// jsonc is JSON with comments. All comments are full line starting with //. The entire line is removed before parsing.
// You can safely use // inside a url just not at the start of a line.
//
// Nesting from external files:
// ----------------------------
// You can use the special key "$ref" to include a JSON file from the local filesystem. The value of "$ref" is a relative path to the file.
//

	// You can have more than one Formalizer in an Endpoint, but an EvidenceGraph only uses one. Multiple formalizers could be used
	// by Agents or more than one EvidenceGraph. You can also share one Formalizer in different Agents or EvidenceGraphs. The Formalizer
	// knows its ontology (but not the instances that exist): it completes every question with the types and relations of the ontology
	// and passes it to the Decider of that question.
	"Formalizer": {
		"name": "Formalizer",

		// "extra_args" is given to the formalizer's constructor.
		"extra_args": {
			// The description will be exposed in the Formalizer's Agentic API. It can be a string or a list of strings.
			"description": "This Agentic Formalizer extracts entities and relationships from text using the ontology.",

			// The "name" of the AgenticGraph in ontologies.jsonc that the Formalizer uses as its ontology (mandatory). It is validated
			// while piloting.
			"ontology": "ontology",

			// Every question the Formalizer answers has a key: "extract_nodes", "match_node" and "extract_edges" with the "name" of the
			// Decider (in deciders.jsonc) that answers it. If it is missing or null, the question is not exposed by the Formalizer.

			// extract_nodes: every mention of a type of the ontology in a text.
			"extract_nodes": "NodesGLiNER2",

			// extract_edges: every edge of a relation of the ontology between the nodes of a text.
			"extract_edges": "EdgesGLiNER2",

			// match_node: whether a mention is a known instance. Not exposed until a Decider for it is available.
			"match_node": null
		},

		// The ontology and the Deciders, so that the Endpoint will provide them to the Formalizer.
		"tools": ["ontology", "NodesGLiNER2", "EdgesGLiNER2"]
	}
}
