{
// NOTE on EDITING:
// ----------------
// jsonc is JSON with comments. All comments are full line starting with //. The entire line is removed before parsing.
// You can safely use // inside a url just not at the start of a line.
//
// Nesting from external files:
// ----------------------------
// You can use the special key "$ref" to include a JSON file from the local filesystem. The value of "$ref" is a relative path to the file.
//

	// You can have more than one Formalizer in an Endpoint, but an EvidenceGraph only uses one. Multiple formalizers could be used
	// by Agents or more than one EvidenceGraph. You can also share one Formalizer in different Agents or EvidenceGraphs but make sure
	// the ontology remains consistent. The Formalizer itself has no state other than this configuration.
	"GLiNER2": {
		"name": "GLiNER2",

		// "extra_args" is given to the formalizer's constructor.
		"extra_args": {
			// The description will be exposed in the Formalizer's Agentic API. It can be a string or a list of strings.
			"description": "This Agentic Formalizer extracts entities and relationships from text.",

			"model": {
				// This is mandatory to support other technologies in the future.
				"library": "gliner2",

				// Since August 2026, 2.5 is the current architecture (boundary architecture), use "small" (instead of "base") if you have
				// limited resources or "multi" for multilingual support.
				"model": "fastino/gliner2.5-base-v1",

				// Use these options with care! If not null, they will be passed to AutoExtractor.from_pretrained() as arguments.
				// "map_location": "cuda" may actually slow down and interfere with the Agent's use of the GPU.
				"map_location": null,

				// This may only work on the GPU, set it to true if you know what you are doing.
				"quantize": null,

				// This may only work on the GPU, set it to true if you know what you are doing.
				"compile": null
			},

			// The AgenticGraph the Formalizer uses as its ontology (mandatory). The key is the role and the value is the "name" of that
			// AgenticGraph in ontologies.jsonc (both happen to be "ontology" in this template). It must also be in "tools".
			"ontology": "ontology",

			// Words left out when the name of a mention is compared with that of a known instance (e.g., "Ms. Ruiz" with "Elena Ruiz").
			// These are the defaults: titles in English. Change them for documents in other languages.
			"ignored_words": ["mr", "mrs", "ms", "miss", "dr", "prof"],

			// The score (0..1) of is_same_node from which a mention that is only part of the name of a known instance is linked to it
			// (e.g., "Ms. Ruiz" has 0.5 with "Elena Ruiz"). This is the default.
			"same_node_threshold": 0.3
		},

		// "tools" is an argument for the Endpoint to serve these tools to the Formalizer. This must include the name in "ontology".
		"tools": ["ontology"]
	}
}
