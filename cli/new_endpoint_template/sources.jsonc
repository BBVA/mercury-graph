{
// NOTE on EDITING:
// ----------------
// jsonc is JSON with comments. All comments are full line starting with //. The entire line is removed before parsing.
// You can safely use // inside a url just not at the start of a line.
//
// Nesting from external files:
// ----------------------------
// You can use the special key "$ref" to include a JSON file from the local filesystem. The value of "$ref" is a relative path to the file.
//

	"wikipedia_2025": {
		"name": "wikipedia_2025",

		// "extra_args" is given to the source's constructor.
		"extra_args": {
			// The description will be exposed in the Sources's Agentic API. It can be a string or a list of strings.
			"description": "This is the wikipedia dump enwiki-20260101-pages-articles-multistream.xml in markdown format.",

			// The arguments passed to the SourceMaker
			"type": "xml_stream",
			"src_path": "/storage/nlp/corpora/en_wiki_20260101/enwiki-20260101-pages-articles-multistream.xml",
			"dst_path": "/storage/temp/markdown/wiki_20260101/",

			// No need to filter by extensions, since "xml_stream" creates only markdown files.
			"extensions": [],

			// Cache options: cache_size (in objects) = 0, prevents caching, cache_save = extension must be .pickle or no saving.
			"cache_size": 1024,
			"cache_save": "/storage/temp/cache/wikipedia_2025.pickle",

			// ChromaDB options: chroma_persist_path must be a directory that will be passed as the argument persist_directory to
			//		chromadb.Settings. If not accepted, vector DB will be disabled.
			"chroma_persist_path": "/storage/temp/chroma/wikipedia_2025",
			"chroma_descriptions_collection_name": "descriptions",
			"chroma_chunks_collection_name": "chunks"
		},

		// "tools" is expected by the Endpoint to make all Agentic configurations consistent. Sources do not use tools.
		"tools": []
	},

	"bertrand_russell_works": {
		"name": "bertrand_russell_works",

		"extra_args": {
			"description": "This is a collection of Bertrand Russell's works in pdf format.",

			"type": "pdf_mirror",
			"src_path": "/storage/temp/pdf_examples/bertrand_russell/",
			"dst_path": "/storage/temp/markdown/bertrand_russell/",

			"extensions": [".pdf"],

			"cache_size": 0,
			"cache_save": null,

			"chroma_persist_path": null,
			"chroma_descriptions_collection_name": null,
			"chroma_chunks_collection_name": null
		},
		"tools": []
	},

	"markdown_example": {
		"name": "markdown_example",

		"extra_args": {
			"description": "This is a collection of markdown files.",

			"type": "markdown_tree",
			"src_path": null,
			"dst_path": "/storage/temp/markdown_examples/",

			"extensions": [".md"],

			"cache_size": 0,
			"cache_save": null,

			"chroma_persist_path": null,
			"chroma_descriptions_collection_name": null,
			"chroma_chunks_collection_name": null
		},
		"tools": []
	}
}
